#!/usr/bin/python3

import argparse
import llm
import os
import prompt_toolkit as pt
import pygments as pg
import sqlite_utils
import sys
import threading
import time

db = sqlite_utils.Database(llm.user_dir() / "logs.db")

def hide_cursor(): print("\033[?25l", end="")
def show_cursor(): print("\033[?25h", end="")

def spinner(stop):
    s = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    i = 0
    hide_cursor()
    while not stop.is_set():
        print(f"{s[i]}\r", end="")
        i = (i + 1) % len(s)
        time.sleep(.1)
    show_cursor()

def show_models():
    aliases_by_id = {}
    for alias, model in llm.get_model_aliases().items():
        model_id = model.model_id
        if alias != model_id:
            aliases_by_id.setdefault(model_id, []).append(alias)

    print("Available models:")
    for model in llm.get_models():
        model_id = model.model_id
        aliases = aliases_by_id.get(model_id)
        if aliases: print(f"  {model_id:<32} (alias: {', '.join(aliases)})")
        else: print(f"  {model_id}")

def show_threads(model, count):
    where = f"WHERE turns.model = '{model.model_id}'" if model else ""
    limit = f"LIMIT {count}" if count else ""
    threads = db.query(f"""SELECT DISTINCT threads.id, threads.name, threads.datetime_utc
FROM threads JOIN turns ON threads.id = thread_id
{where}
ORDER BY threads.datetime_utc DESC
{limit}
""")

    print("Recent threads:")
    for thread in threads:
        prompts = [ row["prompt"] for row in db.query(f"""SELECT prompt
FROM turns JOIN turn_search ON turns.id = turn_search.turn_id
WHERE turns.thread_id = '{thread['id']}'
ORDER BY turns.datetime_utc ASC
""") ]
        prompt = prompts[0] + " … " + prompts[-1] if len(prompts) > 1 else prompts[0] if len(prompts) == 1 else "???"
        prompt = prompt.replace("\n", "").strip()
        if len(prompt) > 120: prompt = prompt[:58] + " … " + prompt[-58:]

        print("─" * 40)
        print(f"thread: {thread['id']}")
        print(f"  name: {thread['name']}")
        print(f"  date: {thread['datetime_utc'][:19].replace('T', ' ')}")
        print(f"prompt: {prompt}")

def get_model(name):
    model = None
    try:
        if name == "llc": name = None
        model = llm.get_model(name)

    except llm.UnknownModelError:
        found = [ m for m in llm.get_models() if name in m.model_id ]
        if not found:
            print(f"Model '{name}' not found")
        elif len(found) > 1:
            print(f"Found more than one model matching '{name}':");
            for m in found: print(m.model_id)
        else: model = found[0]

    return model

####################
parser = argparse.ArgumentParser(add_help=False)
parser.add_argument("-h", "--help", action="help", help="""
    Show this help message and exit.
""")
parser.add_argument("-H", "--history", metavar="num", nargs="?", type=int, const=10, help="""
    Show thread history. Defaults to the 10 most recent threads if <num> is omitted. Use 0 to show all.
    When used together with the -m option, only shows history for that specific model.
""")
parser.add_argument("-m", "--model", metavar="name", nargs="?", const="show_models", help="""
    Specify the model to use (partial names allowed). If omitted, shows available models.
""")
args = parser.parse_args()

if args.model == "show_models":
    show_models()
    exit(0)

name = args.model or os.path.basename(sys.argv[0])
model = get_model(name)
if not model: exit(1)

if args.history is not None:
    show_threads(model, args.history)
    exit(0)

print(f"Using model '{model.model_id}'")

convo = model.conversation()

style = pt.styles.pygments.style_from_pygments_cls(
    pg.styles.get_style_by_name("monokai")
)
pg_markdown = pg.lexers.MarkdownLexer()
pt_markdown = pt.lexers.PygmentsLexer(pg.lexers.MarkdownLexer)

try:
    print("─" * 40)
    while True:
        prompt = pt.prompt("> ", multiline=True, style=style, lexer=pt_markdown)
        if not prompt.strip(): continue
        print("·" * 40)

        stop = threading.Event()
        thread = threading.Thread(target=spinner, args=(stop,))
        thread.start()

        try:
            response = None
            response = convo.prompt(prompt)
            response.log_to_db(db)
            response = response.text()
        except Exception as e:
            print(f"Error: {e}")
        finally:
            stop.set()
            thread.join()

        if response:
            tokens = pt.formatted_text.PygmentsTokens(pg.lex(response, lexer=pg_markdown))
            pt.print_formatted_text(tokens, style=style)
        print("─" * 40)

except EOFError:
    pass
except KeyboardInterrupt:
    pass
finally:
    show_cursor()
