#!/usr/bin/python3

import llm
import os
import prompt_toolkit as pt
import pygments as pg
import sqlite_utils
import sys
import threading
import time

def hide_cursor(): print("\033[?25l", end="")
def show_cursor(): print("\033[?25h", end="")

def spinner(stop):
    s = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    i = 0
    hide_cursor()
    while not stop.is_set():
        print(f"{s[i]}\r", end="")
        i = (i + 1) % len(s)
        time.sleep(.1)
    show_cursor()

name = os.path.basename(sys.argv[0])
if name == "llc":
    model = llm.get_model()
else:
    found = [model for alias, model in llm.get_model_aliases().items() if name == alias]
    if len(found) < 1: found = [model for model in llm.get_models() if name == model.model_id]
    if len(found) < 1: found = [model for model in llm.get_models() if name in model.model_id]

    if len(found) < 1:
        print(f"Model '{name}' not found")
        exit(1)
    elif len(found) > 1:
        print(f"Found more than one model matching '{name}':");
        for model in found: print(model.model_id)
        exit(1)
    else: model = found[0]

print(f"Using model '{model.model_id}'")

convo = model.conversation()
db = sqlite_utils.Database(llm.user_dir() / "logs.db")

style = pt.styles.pygments.style_from_pygments_cls(
    pg.styles.get_style_by_name("monokai")
)
pg_markdown = pg.lexers.MarkdownLexer()
pt_markdown = pt.lexers.PygmentsLexer(pg.lexers.MarkdownLexer)

try:
    print("─" * 40)
    while True:
        prompt = pt.prompt("> ", multiline=True, style=style, lexer=pt_markdown)
        if not prompt.strip(): continue
        print("·" * 40)

        stop = threading.Event()
        thread = threading.Thread(target=spinner, args=(stop,))
        thread.start()

        try:
            response = None
            response = convo.prompt(prompt)
            response.log_to_db(db)
            response = response.text()
        except Exception as e:
            print(f"Error: {e}")
        finally:
            stop.set()
            thread.join()

        if response:
            tokens = pt.formatted_text.PygmentsTokens(pg.lex(response, lexer=pg_markdown))
            pt.print_formatted_text(tokens, style=style)
        print("─" * 40)

except EOFError:
    pass
except KeyboardInterrupt:
    pass
finally:
    show_cursor()
